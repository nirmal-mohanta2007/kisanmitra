rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Kisan Mitra — Firestore Security Rules
//
// Role hierarchy:
//   farmer   → can only access their own data
//   operator → can access operational data for their assigned centre
//   admin    → can access all monitoring/analytics data
//
// Every authenticated user has a document at users/{uid}
// with a "role" field: "FARMER" | "OPERATOR" | "ADMIN"
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isFarmer() {
      return isSignedIn() && (getUserRole() == 'FARMER' || getUserRole() == 'farmer');
    }

    function isOperator() {
      return isSignedIn() && (getUserRole() == 'OPERATOR' || getUserRole() == 'operator');
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'ADMIN' || getUserRole() == 'admin');
    }

    function isOperatorOrAdmin() {
      return isOperator() || isAdmin();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users/{uid} ───────────────────────────────────────────────────────────
    // Users can read/write ONLY their own profile.
    // Admins can read any user profile.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── farmers/{farmerId} ────────────────────────────────────────────────────
    // Farmers: read/write their own document.
    // Operators: read-only access to all farmer documents (needed for verification).
    // Admins: full access.
    match /farmers/{farmerId} {
      allow read:   if isOperatorOrAdmin()
                    || (isFarmer() && resource.data.uid == request.auth.uid);
      allow create: if isFarmer() && request.resource.data.uid == request.auth.uid;
      allow update: if (isFarmer() && resource.data.uid == request.auth.uid)
                    || isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    // ── transactions/{txId} ───────────────────────────────────────────────────
    // Farmers: read/write their own transactions.
    // Operators: read/write transactions for their assigned centre.
    // Admins: full access.
    match /transactions/{txId} {
      allow read:   if (isFarmer() && resource.data.farmerId == request.auth.uid)
                    || isOperatorOrAdmin();
      allow create: if isFarmer()
                    || isOperatorOrAdmin();
      allow update: if (isFarmer() && resource.data.farmerId == request.auth.uid)
                    || isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    // ── centres/{centreId} ────────────────────────────────────────────────────
    // All authenticated users can read centres (needed for farmer booking).
    // Only operators and admins can create/update centre records.
    match /centres/{centreId} {
      allow read:   if isSignedIn();
      allow create: if isOperatorOrAdmin();
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    // ── bookings/{bookingId} ──────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read:   if (isFarmer() && resource.data.farmerId == request.auth.uid)
                    || isOperatorOrAdmin();
      allow create: if isFarmer() && request.resource.data.farmerId == request.auth.uid;
      allow update: if (isFarmer() && resource.data.farmerId == request.auth.uid)
                    || isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    // ── queue/{queueId} ───────────────────────────────────────────────────────
    match /queue/{queueId} {
      allow read:   if isSignedIn();
      allow write:  if isOperatorOrAdmin();
    }

    // ── payments/{paymentId} ─────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:   if (isFarmer() && resource.data.farmerId == request.auth.uid)
                    || isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin();
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    // ── analytics/{docId} — admin-only ───────────────────────────────────────
    match /analytics/{docId} {
      allow read:   if isAdmin();
      allow write:  if isAdmin();
    }

    // ── system/{docId} — admin-only ──────────────────────────────────────────
    match /system/{docId} {
      allow read:   if isAdmin();
      allow write:  if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
